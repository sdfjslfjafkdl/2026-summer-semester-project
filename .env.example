# ── 애플리케이션 ────────────────────────────────────────────────
APP_ENV=local
LOG_LEVEL=INFO

# 서버 포트. Railway 는 이 값을 자동 주입하므로 배포 환경에서는 설정하지 않는다.
PORT=8000

# ── 데이터 경로 (프로젝트 루트 기준 상대경로 허용) ──────────────
DATA_DIR=data
PANEL_CSV=data/raw/chungbuk_monthly_model_panel_2017_2024.csv
OOT_REGION_CSV=data/raw/chungbuk_oot_error_analysis_by_region.csv
PANEL_README_MD=data/raw/README_chungbuk_model_panel.md
EVIDENCE_REGISTER_MD=data/raw/project_evidence_register_ko.md
EVIDENCE_PDF_DIR=data/raw/evidence/pdf
ARTIFACT_DIR=data/artifacts

# 근거 검색 캐시. 런타임에 쓰기가 발생하는 유일한 경로다.
# 컨테이너에서는 /app/data/runtime/index 를 쓰며 Railway 볼륨이 그 자리에 마운트된다.
# 비어 있어도, 쓰기가 막혀도 서버는 정상 기동한다(원본에서 다시 만든다).
INDEX_DIR=data/index

# ── CORS 허용 오리진 (콤마 구분) ────────────────────────────────
CORS_ORIGINS=https://impact-advisor-ai.lovable.app,http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:5173

# ── LLM (Layer 2) ──────────────────────────────────────────────
# false 이면 API 키 없이 규칙 기반 라우터/서술로 폴백한다. 발표 데모 안전장치.
LLM_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
LLM_TIMEOUT_SECONDS=60
