# 비밀값. .env.example 만 커밋한다.
.env

# 가상환경·캐시
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.DS_Store

# 근거 검색 인덱스 캐시. 원본에서 언제든 재생성된다.
data/index/
data/runtime/

# 투자계획서 서식 안내서 PDF. 한국지방재정공제회 배포 자료라 저장소에 재배포하지 않는다.
# 섹션 구조는 app/data/plan_sections.py 에 옮겨 두었으므로 없어도 서버는 동작한다.
data/raw/plan_template/

# 사업내역서 PDF. 담당 공무원 실명이 들어 있어 저장소에 올리지 않는다.
# 팀 내부에서 별도 전달받아 data/raw/evidence/pdf/ 에 넣으면 검색 인덱스가 자동으로 확장된다.
data/raw/evidence/pdf/
