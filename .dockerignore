# 캐시·부산물
__pycache__
**/__pycache__
*.py[cod]
.DS_Store
**/.DS_Store

# 런타임 캐시. 이미지에 굽지 않는다.
#   data/index  : 로컬 개발용 근거 검색 캐시 (컨테이너는 data/runtime/index 를 쓴다)
data/index
data/runtime

# data/artifacts 는 제외하지 않는다.
# build_artifacts.py 가 만드는 것은 v1 두 개(did_twfe, oot_validation)뿐이고,
# 진단 아티팩트(did_diagnostics_v3.json)처럼 분석 담당자가 건네주는 파일은
# 저장소가 원본이다. 통째로 제외하면 그 파일이 이미지에서 빠져 503 이 난다.

# 컨테이너 정의 자체
Dockerfile
.dockerignore
docker-compose.yml
railway.json
